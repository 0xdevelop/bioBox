[Unit]
Description=bioBox (bb_service) service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# 停止/重启时清理整个控制组（含 protenix-run / pxdesign-run 任务进程组），不能只杀 MAINPID
KillMode=control-group
Restart=on-failure
RestartSec=5s
ExecStart=/bb_service/bb_service
ExecStop=/bin/kill -TERM $MAINPID
WorkingDirectory=/bb_service
LimitNOFILE=102400

[Install]
WantedBy=multi-user.target
