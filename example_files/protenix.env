# Protenix 运行配置。update 时保留本文件。
# 当前受管profile仅支持公开v1；MSA/template/ESM/v2等未协调分支会拒绝。
# 不能仅改模型名或放入v2权重就视为已受支持；v2授权与资源profile须另核查。
PROTENIX_MODEL=protenix_base_default_v1.0.0
# 权重与 CCD 数据目录
PROTENIX_ROOT_DIR=@PREFIX@/data
CUDA_HOME=/usr/local/cuda-13.0
# GB10 上上游自定义 layernorm 内核编译不过，用 torch 实现
LAYERNORM_TYPE=torch
# 只用某块 GPU 时取消注释
# CUDA_VISIBLE_DEVICES=0

# Process-local library caches; relative values are rooted at this runtime.
RUNTIME_CACHE_DIR=@PREFIX@/data/cache
