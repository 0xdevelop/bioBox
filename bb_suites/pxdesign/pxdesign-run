#!/bin/bash
# PXDesign 命令入口：加载 conf/pxdesign.env 和当前版本的 venv，再执行上游 pxdesign。
#   pxdesign-run pipeline --preset preview -i task.yaml -o out_dir [其它参数]
# pipeline 未给时自动补：--load_checkpoint_dir（配置里的权重目录）、--use_fast_ln False、--num_workers 0。
# 输出目录下出现 ERR/ 时返回 3（上游此时可能仍返回 0）。
set -euo pipefail

PREFIX="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# 权重与运行环境由服务在 exec/ssh 之前核对。本包装只启动已通过检查的 Python。

ENV_FILE="${PREFIX}/conf/pxdesign.env"
# Ignore inherited owned-resource roots; only this runtime config is authoritative.
unset PROTENIX_ROOT_DIR PROTENIX_MODEL PXDESIGN_DATA PXDESIGN_CHECKPOINT_DIR TOOL_WEIGHTS_ROOT PROTENIX_DATA_ROOT_DIR RUNTIME_CACHE_DIR
PXDESIGN_DATA="${PREFIX}/data"
unset PXDESIGN_CHECKPOINT_DIR TOOL_WEIGHTS_ROOT PROTENIX_DATA_ROOT_DIR

if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
fi

# Relative resource config values are rooted at this runtime, never cwd.
resource_path() { case "$1" in /*) printf '%s\n' "$1";; *) printf '%s/%s\n' "${PREFIX}" "$1";; esac; }

if [[ -x "${PREFIX}/current/venv/bin/pxdesign" ]]; then
  VENV="${PREFIX}/current/venv"
elif [[ -x "${PREFIX}/venv/bin/pxdesign" ]]; then
  VENV="${PREFIX}/venv"
else
  echo "[pxdesign-run] 找不到 pxdesign，请先执行 install_pxdesign.sh install" >&2
  exit 127
fi
DATA="$(resource_path "${PXDESIGN_DATA:-data}")"
export TOOL_WEIGHTS_ROOT="$(resource_path "${TOOL_WEIGHTS_ROOT:-${DATA}/tool_weights}")"
export PROTENIX_DATA_ROOT_DIR="$(resource_path "${PROTENIX_DATA_ROOT_DIR:-${DATA}/protenix_data}")"
CKPT_DIR="$(resource_path "${PXDESIGN_CHECKPOINT_DIR:-${DATA}/release_data/checkpoint}")"
export LAYERNORM_TYPE="${LAYERNORM_TYPE:-torch}"
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.0}"
# Keep interpreter resolution and caches process-local to the owned runtime.
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1
CACHE_ROOT="$(resource_path "${RUNTIME_CACHE_DIR:-data/cache}")"
export XDG_CACHE_HOME="${CACHE_ROOT}/xdg" TORCH_HOME="${CACHE_ROOT}/torch"
export TORCH_EXTENSIONS_DIR="${CACHE_ROOT}/torch_extensions" TRITON_CACHE_DIR="${CACHE_ROOT}/triton"
export MPLCONFIGDIR="${CACHE_ROOT}/matplotlib" JAX_COMPILATION_CACHE_DIR="${CACHE_ROOT}/jax"
export NUMBA_CACHE_DIR="${CACHE_ROOT}/numba" MODELSCOPE_CACHE="${CACHE_ROOT}/modelscope" HF_HOME="${CACHE_ROOT}/huggingface"
export VIRTUAL_ENV="${VENV}"
export PATH="${VENV}/bin:${CUDA_HOME}/bin:${PATH}"



if [[ "${1:-}" != "pipeline" ]]; then
  case "${1:-}" in --help|-h) exec "${VENV}/bin/pxdesign" "$@";; *) echo "[pxdesign-run] unsupported unmanaged subcommand" >&2; exit 4;; esac
fi

args=("$@")
use_msa="" use_template=false use_rna_msa=false preset=preview
out_dir=""
has_ckpt=0 has_ln=0 has_workers=0
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    --use_msa) use_msa="${args[i+1]:-}" ;;
    --use_msa=*) use_msa="${args[i]#--use_msa=}" ;;
    --use_template) use_template="${args[i+1]:-}" ;;
    --use_template=*) use_template="${args[i]#--use_template=}" ;;
    --use_rna_msa) use_rna_msa="${args[i+1]:-}" ;;
    --use_rna_msa=*) use_rna_msa="${args[i]#--use_rna_msa=}" ;;

    --preset) preset="${args[i+1]:-}" ;;
    --preset=*) preset="${args[i]#--preset=}" ;;
    -o|--dump_dir) out_dir="${args[i+1]:-}" ;;
    --dump_dir=*) out_dir="${args[i]#--dump_dir=}" ;;
    --load_checkpoint_dir|--load_checkpoint_dir=*) echo "[pxdesign-run] checkpoint root is runtime-conf only" >&2; exit 4 ;;
    --use_fast_ln|--use_fast_ln=*) has_ln=1 ;;
    --num_workers|--num_workers=*) has_workers=1 ;;
    -i|--input|--input=*|--N_sample|--N_sample=*|--N_step|--N_step=*|--N_max_runs|--N_max_runs=*|--dtype|--dtype=*|--eta_max|--eta_max=*|--eta_min|--eta_min=*|--eta_type|--eta_type=*) ;;
    -*) echo "[pxdesign-run] unsupported unmanaged option" >&2; exit 4 ;;
  esac
done
[[ ${has_ckpt} -eq 1 ]] || args+=(--load_checkpoint_dir "${CKPT_DIR}")
[[ ${has_ln} -eq 1 ]] || args+=(--use_fast_ln False)
[[ ${has_workers} -eq 1 ]] || args+=(--num_workers 0)


[[ "${use_msa,,}" == false && "${use_template,,}" == false && "${use_rna_msa,,}" == false ]] || { echo "[pxdesign-run] uncoordinated MSA/template branch unsupported; explicitly pass --use_msa false" >&2; exit 4; }
[[ "${preset,,}" == preview ]] || { echo "[pxdesign-run] only coordinated preview profile supported" >&2; exit 4; }

rc=0
"${VENV}/bin/pxdesign" "${args[@]}" || rc=$?
if [[ ${rc} -eq 0 && -n "${out_dir}" && -d "${out_dir}/ERR" && -n "$(ls -A "${out_dir}/ERR")" ]]; then
  echo "[pxdesign-run] 有任务失败，见 ${out_dir}/ERR/" >&2
  exit 3
fi
exit "${rc}"
